[Unit]
Description=nodespot privileged helper socket

[Socket]
ListenStream=/run/nodespot/helper.sock
# Only root and the nodespot group (the web service) can connect; the helper also
# checks the peer uid with SO_PEERCRED.
SocketMode=0660
SocketUser=root
SocketGroup=nodespot
DirectoryMode=0755
RemoveOnStop=true

[Install]
WantedBy=sockets.target
