[Unit]
Description=nodespot native node (one radio, one network mode)
Documentation=file:///usr/share/doc/nodespot/README
Wants=md380-emu.service
After=network-online.target md380-emu.service
Wants=network-online.target

[Service]
Type=simple
User=nodespot-node
Group=nodespot-node
# The sound card (audio); the CM108 hidraw and the CH340 serial port get
# group nodespot-node from 60-nodespot-node.rules.
SupplementaryGroups=audio
ExecStart=/usr/libexec/nodespot/nodespot-node -config /etc/nodespot/node.json -socket /run/nodespot-node/control.sock
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
# Exit 78 (EX_CONFIG): the config file is invalid; restarting cannot fix it.
RestartPreventExitStatus=78
RuntimeDirectory=nodespot-node
RuntimeDirectoryMode=0750
# node.json and sa818.json are written here (0600, owned by nodespot-node).
ReadWritePaths=/etc/nodespot
UMask=0007
Nice=-5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-alsa rw
DeviceAllow=char-hidraw rw
DeviceAllow=char-ttyUSB rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
