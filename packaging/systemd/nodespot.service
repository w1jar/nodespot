[Unit]
Description=nodespot web control panel
Documentation=file:///usr/share/doc/nodespot/README
After=network.target nodespot-helper.socket
Wants=nodespot-helper.socket

[Service]
Type=simple
User=nodespot
Group=nodespot
# Access to the node's control socket comes from the nodespot user's membership
# in group "nodespot-node" (added by the package's postinst); systemd applies the
# user's supplementary groups at start.
ExecStart=/usr/bin/nodespot --config /etc/nodespot/nodespot.conf
Restart=on-failure
RestartSec=3
# Exit status 75 is nodespot asking for a restart after a restore (the restored
# database is swapped in at start): not a failure, but restart anyway.
SuccessExitStatus=75
RestartForceExitStatus=75
TimeoutStopSec=15
UMask=0027

# Hardening. The service can read /etc/nodespot, /sys/class/thermal and /proc
# (read-only views are kept) and write only to its data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nodespot
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Not @resources: the Go runtime raises its RLIMIT_NOFILE soft limit at start.
SystemCallFilter=~@privileged
# Fail a filtered call with EPERM instead of killing the service.
SystemCallErrorNumber=EPERM
# No capabilities. For a listen port below 1024 nodespot needs the drop-in
# nodespot.service.d/port80.conf (AmbientCapabilities and CapabilityBoundingSet
# = CAP_NET_BIND_SERVICE). The System tab, Web port section, writes it when
# you move nodespot to port 80 (install.sh writes the same file for NODESPOT_PORT=80
# and NODESPOT_TAKEOVER=1) and "apt purge nodespot" removes it.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
