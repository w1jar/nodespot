[Unit]
Description=nodespot privileged helper
Documentation=file:///usr/share/doc/nodespot/README
Requires=nodespot-helper.socket
After=nodespot-helper.socket

[Service]
Type=simple
# Runs as root, socket-activated; exits after 60 s without requests.
ExecStart=/usr/libexec/nodespot/nodespot-helper
# Browser terminal sessions do not run from this unit: the helper starts each one
# as its own transient unit (nodespot-term-<id>.service, running `nodespot-helper
# term-host`, no sandbox) and only relays to it. A restart of this helper
# therefore leaves sessions running (detached), and a user shell does not
# inherit this unit's mount namespace, so PrivateTmp and ProtectHome stay on.
# term-host's socket directory is /run/nodespot/term, which needs no
# ReadWritePaths because this unit has no ProtectSystem.
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
